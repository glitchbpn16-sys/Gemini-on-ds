# Platform tokens — create your own bot applications; never commit real tokens.
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Generic bearer token for game/community mod integrations.
# Use a long random value. This endpoint is disabled when the value is empty.
MODS_API_TOKEN=

# Add one or more provider API keys. API usage may be billed separately.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Default provider and optional ordered fallback list.
AI_DEFAULT_PROVIDER=openrouter
AI_FALLBACK_ORDER=

# Models are configurable because availability depends on your provider account.
OPENAI_MODEL=gpt-6-astra
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.8-flash
XAI_MODEL=grok-4.7
OPENROUTER_MODEL=openrouter/free

# Optional OpenRouter app identification.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Glitch AI Bridge

# Runtime.
HOST=0.0.0.0
PORT=8080
MAX_PROMPT_CHARS=8000
MAX_OUTPUT_TOKENS=1200
