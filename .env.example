# Platform tokens — create your own bot applications; never commit real tokens.
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Generic Bearer token for game/community mod integrations.
MODS_API_TOKEN=

# Add one or more first-party provider API keys; API usage may be billed separately.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Any endpoint that implements the OpenAI Chat Completions wire format.
# Use HTTPS for remote services. Plain HTTP is allowed for localhost only.
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODEL=local-model
CUSTOM_OPENAI_ALLOW_INSECURE_HTTP=false

# Default provider and explicitly ordered fallback list.
# Fallback requests can incur additional API charges.
AI_DEFAULT_PROVIDER=
AI_FALLBACK_ORDER=

# Models are configurable because availability depends on your provider account.
OPENAI_MODEL=gpt-6-astra
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.8-flash
XAI_MODEL=grok-4.7
OPENROUTER_MODEL=openrouter/free
GROQ_MODEL=qwen/qwen3.8-27b
DEEPSEEK_MODEL=deepseek-flash
MISTRAL_MODEL=mistral-large-latest
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Optional OpenRouter app identification.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Glitch AI Bridge

# Existing game/mod HTTP API.
HOST=0.0.0.0
PORT=8080

# MCP Connect mode. Disabled by default, local-only by default.
MCP_ENABLED=false
MCP_API_TOKEN=
# Keep MCP on loopback; use an HTTPS reverse proxy for remote clients.
MCP_HOST=127.0.0.1
MCP_PORT=8081

# Resource and energy budget: bounded concurrency, request size and time.
MAX_PROMPT_CHARS=8000
MAX_OUTPUT_TOKENS=1200
MAX_CONCURRENT_AI_REQUESTS=2
AI_REQUEST_TIMEOUT_SECONDS=45
AI_REQUESTS_PER_MINUTE=8
